{
  "name": "online-quiz",
  "version": "1.0.0",
  "scripts": {
    "install-all": "npm install && cd quiz-app && npm install && cd ../server && npm install",
    "client": "cd quiz-app && npm run dev",
    "server": "cd server && node index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
